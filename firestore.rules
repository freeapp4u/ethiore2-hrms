rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn() && getUserData().role == 'Administrator';
    }

    function isHROfficer() {
      return isSignedIn() && (getUserData().role == 'HR Officer' || getUserData().role == 'Administrator');
    }

    function isAuditor() {
      return isSignedIn() && getUserData().role == 'Auditor';
    }

    function isEmployee() {
      return isSignedIn() && getUserData().role == 'Employee';
    }

    function isStaff() {
      return isHROfficer() || isAdmin();
    }

    function isOwnerEmail(email) {
      return isSignedIn() && request.auth.token.email != null && request.auth.token.email.lower() == email.lower();
    }

    function isOwnerUid(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function getEmployeeId() {
      return getUserData().employeeId;
    }

    function isOwnRecord(employeeId) {
      return isSignedIn() && getEmployeeId() != null && getEmployeeId() == employeeId;
    }

    // Default deny rule
    match /{document=**} {
      allow read, write: if false;
    }

    // User Accounts collection
    match /users/{userId} {
      allow read: if isSignedIn() && (isOwnerUid(userId) || isStaff() || isAuditor());
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        // Non-admin users cannot alter their own 'role' field
        (isOwnerUid(userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])) ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // Employee Master records
    match /employees/{empId} {
      allow read: if isSignedIn() && (
        isStaff() || 
        isAuditor() || 
        isOwnRecord(empId) ||
        isOwnerEmail(resource.data.email)
      );
      allow create, update: if isStaff();
      allow delete: if isAdmin();
    }

    // Departments
    match /departments/{deptId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Attendance Records
    match /attendance/{attId} {
      allow read: if isSignedIn() && (
        isStaff() || 
        isAuditor() || 
        isOwnRecord(resource.data.employeeId) ||
        isOwnerEmail(resource.data.employeeEmail)
      );
      allow create, update: if isStaff();
      allow delete: if isStaff();
    }

    // Leave Applications & Records
    match /leaves/{leaveId} {
      allow read: if isSignedIn() && (
        isStaff() || 
        isAuditor() || 
        isOwnRecord(resource.data.employeeId) ||
        isOwnerEmail(resource.data.employeeEmail)
      );
      allow create: if isSignedIn();
      allow update: if isStaff() || (
        isEmployee() && 
        isOwnRecord(resource.data.employeeId) &&
        resource.data.status == 'Active' && 
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'recordedBy'])
      );
      allow delete: if isStaff();
    }

    // Payslips & Payroll Records
    match /payslips/{payslipId} {
      allow read: if isSignedIn() && (
        isStaff() || 
        isAuditor() || 
        isOwnRecord(resource.data.employeeId) ||
        isOwnerEmail(resource.data.recipientEmail)
      );
      allow write: if isStaff();
      allow delete: if isAdmin();
    }

    match /payroll_records/{recordId} {
      allow read: if isSignedIn() && (
        isStaff() || 
        isAuditor() || 
        isOwnRecord(resource.data.employeeId) ||
        isOwnerEmail(resource.data.employeeEmail)
      );
      allow write: if isStaff();
      allow delete: if isAdmin();
    }

    // Salary Components & Periods
    match /salary_components/{compId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /payroll_periods/{periodId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /employee_salary_structures/{structId} {
      allow read: if isSignedIn() && (isStaff() || isAuditor() || isOwnRecord(resource.data.employeeId));
      allow write: if isStaff();
    }

    // Family Members & Medical Expenses
    match /family_members/{fmId} {
      allow read: if isSignedIn() && (isStaff() || isAuditor() || isOwnRecord(resource.data.employeeId));
      allow create, update: if isSignedIn() && (isStaff() || isOwnRecord(request.resource.data.employeeId));
      allow delete: if isStaff();
    }

    match /medical_expenses/{expId} {
      allow read: if isSignedIn() && (isStaff() || isAuditor() || isOwnRecord(resource.data.employeeId));
      allow create, update: if isSignedIn() && (isStaff() || isOwnRecord(request.resource.data.employeeId));
      allow delete: if isStaff();
    }

    // Company Config & Public Holidays & Activity Logs
    match /config/{configId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /holidays/{holidayId} {
      allow read: if isSignedIn();
      allow write: if isStaff();
    }

    match /logs/{logId} {
      allow read: if isStaff() || isAuditor();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }
  }
}
