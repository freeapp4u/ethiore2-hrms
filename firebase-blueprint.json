{
  "entities": {
    "User": {
      "title": "User",
      "description": "An administrative operator or HR Officer of the HRMS system.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "fullName": { "type": "string", "maxLength": 256 },
        "email": { "type": "string", "maxLength": 256, "pattern": "^[^@]+@[^@]+\\.[^@]+$" },
        "role": { "type": "string", "enum": ["Administrator", "HR Officer", "Auditor"] },
        "status": { "type": "string", "enum": ["Active", "Inactive", "Suspended"] },
        "createdDate": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "fullName", "email", "role", "status", "createdDate"]
    },
    "Department": {
      "title": "Department",
      "description": "An organizational unit within Ethiopian Reinsurance.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 128 },
        "code": { "type": "string", "maxLength": 32 },
        "description": { "type": "string", "maxLength": 512 },
        "status": { "type": "string", "enum": ["Active", "Inactive"] },
        "createdDate": { "type": "string", "maxLength": 64 },
        "updatedDate": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "name", "code", "description", "status", "createdDate", "updatedDate"]
    },
    "Employee": {
      "title": "Employee",
      "description": "An employee record of Ethiopian Reinsurance.",
      "type": "object",
      "properties": {
        "employeeId": { "type": "string", "maxLength": 128 },
        "firstName": { "type": "string", "maxLength": 128 },
        "middleName": { "type": "string", "maxLength": 128 },
        "lastName": { "type": "string", "maxLength": 128 },
        "fullName": { "type": "string", "maxLength": 384 },
        "gender": { "type": "string", "enum": ["Male", "Female"] },
        "dob": { "type": "string", "maxLength": 16 },
        "email": { "type": "string", "maxLength": 256, "pattern": "^[^@]+@[^@]+\\.[^@]+$" },
        "phoneNumber": { "type": "string", "maxLength": 32 },
        "address": { "type": "string", "maxLength": 512 },
        "departmentId": { "type": "string", "maxLength": 128 },
        "position": { "type": "string", "maxLength": 128 },
        "employmentType": { "type": "string", "enum": ["Permanent", "Contract", "Temporary", "Intern"] },
        "hireDate": { "type": "string", "maxLength": 16 },
        "status": { "type": "string", "enum": ["Active", "Inactive"] },
        "createdDate": { "type": "string", "maxLength": 64 },
        "createdBy": { "type": "string", "maxLength": 256 },
        "updatedDate": { "type": "string", "maxLength": 64 },
        "updatedBy": { "type": "string", "maxLength": 256 }
      },
      "required": [
        "employeeId",
        "firstName",
        "middleName",
        "lastName",
        "fullName",
        "gender",
        "dob",
        "email",
        "phoneNumber",
        "address",
        "departmentId",
        "position",
        "employmentType",
        "hireDate",
        "status",
        "createdDate",
        "createdBy",
        "updatedDate",
        "updatedBy"
      ]
    },
    "AttendanceRecord": {
      "title": "AttendanceRecord",
      "description": "A daily check-in/check-out timestamp log.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "employeeId": { "type": "string", "maxLength": 128 },
        "date": { "type": "string", "maxLength": 16 },
        "checkInTime": { "type": "string", "maxLength": 16 },
        "checkOutTime": { "type": "string", "maxLength": 16 },
        "status": { "type": "string", "enum": ["Present", "Absent", "Late", "On Leave", "Half Day", "Other"] },
        "workingHours": { "type": "number" },
        "lateStatus": { "type": "string", "enum": ["Yes", "No"] },
        "remarks": { "type": "string", "maxLength": 512 },
        "recordedBy": { "type": "string", "maxLength": 256 },
        "createdDate": { "type": "string", "maxLength": 64 },
        "updatedDate": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "employeeId", "date", "checkInTime", "checkOutTime", "status", "workingHours", "lateStatus", "remarks", "recordedBy", "createdDate", "updatedDate"]
    },
    "LeaveRecord": {
      "title": "LeaveRecord",
      "description": "An employee leave booking ledger entry.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "employeeId": { "type": "string", "maxLength": 128 },
        "leaveType": { "type": "string", "maxLength": 128 },
        "startDate": { "type": "string", "maxLength": 16 },
        "endDate": { "type": "string", "maxLength": 16 },
        "daysCount": { "type": "number" },
        "reason": { "type": "string", "maxLength": 512 },
        "status": { "type": "string", "enum": ["Active", "Completed", "Cancelled"] },
        "remarks": { "type": "string", "maxLength": 512 },
        "recordedBy": { "type": "string", "maxLength": 256 },
        "createdDate": { "type": "string", "maxLength": 64 },
        "updatedDate": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "employeeId", "leaveType", "startDate", "endDate", "daysCount", "reason", "status", "remarks", "recordedBy", "createdDate", "updatedDate"]
    },
    "PublicHoliday": {
      "title": "PublicHoliday",
      "description": "A calendar date marked as a company public holiday.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 256 },
        "date": { "type": "string", "maxLength": 16 }
      },
      "required": ["id", "name", "date"]
    },
    "CompanyConfig": {
      "title": "CompanyConfig",
      "description": "The branding, profile, and policy configurations of the company.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 }
      },
      "required": ["id"]
    },
    "ActivityLog": {
      "title": "ActivityLog",
      "description": "An immutable security transaction and auditing log.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "timestamp": { "type": "string", "maxLength": 64 },
        "userId": { "type": "string", "maxLength": 128 },
        "userEmail": { "type": "string", "maxLength": 256 },
        "userRole": { "type": "string", "maxLength": 128 },
        "module": { "type": "string", "maxLength": 128 },
        "action": { "type": "string", "maxLength": 128 },
        "recordEntity": { "type": "string", "maxLength": 256 },
        "details": { "type": "string", "maxLength": 1024 }
      },
      "required": ["id", "timestamp", "userId", "userEmail", "userRole", "module", "action", "recordEntity", "details"]
    },
    "FamilyMember": {
      "title": "FamilyMember",
      "description": "An employee family member or dependent record.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "employeeId": { "type": "string", "maxLength": 128 },
        "fullName": { "type": "string", "maxLength": 256 },
        "relationship": { "type": "string", "maxLength": 64 },
        "gender": { "type": "string", "enum": ["Male", "Female"] },
        "dob": { "type": "string", "maxLength": 16 },
        "phoneNumber": { "type": "string", "maxLength": 32 },
        "medicalEligibility": { "type": "boolean" },
        "status": { "type": "string", "enum": ["Active", "Inactive"] },
        "createdDate": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "employeeId", "fullName", "relationship", "gender", "dob", "medicalEligibility", "status", "createdDate"]
    },
    "MedicalExpense": {
      "title": "MedicalExpense",
      "description": "A healthcare expense claim record.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "employeeId": { "type": "string", "maxLength": 128 },
        "employeeName": { "type": "string", "maxLength": 256 },
        "beneficiaryType": { "type": "string", "enum": ["Employee", "Family Member"] },
        "beneficiaryId": { "type": "string", "maxLength": 128 },
        "beneficiaryName": { "type": "string", "maxLength": 256 },
        "relationship": { "type": "string", "maxLength": 64 },
        "serviceDescription": { "type": "string", "maxLength": 512 },
        "providerName": { "type": "string", "maxLength": 256 },
        "expenseDate": { "type": "string", "maxLength": 16 },
        "invoiceNumber": { "type": "string", "maxLength": 128 },
        "amountETB": { "type": "number" },
        "receiptAttachmentUrl": { "type": "string", "maxLength": 1024 },
        "remarks": { "type": "string", "maxLength": 512 },
        "status": { "type": "string", "enum": ["Paid", "Pending", "Rejected"] },
        "recordedBy": { "type": "string", "maxLength": 256 },
        "createdDate": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "employeeId", "employeeName", "beneficiaryType", "beneficiaryName", "relationship", "serviceDescription", "providerName", "expenseDate", "invoiceNumber", "amountETB", "status", "recordedBy", "createdDate"]
    },
    "SalaryComponent": {
      "title": "SalaryComponent",
      "description": "Configurable salary earnings and deductions components.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 256 },
        "code": { "type": "string", "maxLength": 64 },
        "type": { "type": "string", "enum": ["Earning", "Deduction"] },
        "calculationMethod": { "type": "string", "enum": ["Fixed Amount", "Percentage", "Formula-Based", "Based on Basic Salary"] },
        "calculationValue": { "type": "number" },
        "isTaxable": { "type": "boolean" },
        "isPensionable": { "type": "boolean" },
        "effectiveDate": { "type": "string", "maxLength": 16 },
        "status": { "type": "string", "enum": ["Active", "Inactive"] },
        "description": { "type": "string", "maxLength": 512 }
      },
      "required": ["id", "name", "code", "type", "calculationMethod", "calculationValue", "isTaxable", "isPensionable", "effectiveDate", "status", "description"]
    },
    "TaxConfiguration": {
      "title": "TaxConfiguration",
      "description": "Ethiopian progressive income tax brackets and statutory pension rules.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "employeePensionRate": { "type": "number" },
        "employerPensionRate": { "type": "number" },
        "transportTaxExemptLimit": { "type": "number" },
        "effectiveDate": { "type": "string", "maxLength": 16 },
        "status": { "type": "string", "enum": ["Active", "Historical"] },
        "updatedBy": { "type": "string", "maxLength": 256 },
        "updatedDate": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "employeePensionRate", "employerPensionRate", "effectiveDate", "status", "updatedBy", "updatedDate"]
    },
    "PayrollPeriod": {
      "title": "PayrollPeriod",
      "description": "Monthly payroll period configuration and lock status.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "periodName": { "type": "string", "maxLength": 128 },
        "startDate": { "type": "string", "maxLength": 16 },
        "endDate": { "type": "string", "maxLength": 16 },
        "paymentDate": { "type": "string", "maxLength": 16 },
        "status": { "type": "string", "enum": ["Open", "Calculated", "Submitted", "Approved", "Closed", "Locked"] },
        "createdBy": { "type": "string", "maxLength": 256 },
        "createdDate": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "periodName", "startDate", "endDate", "paymentDate", "status", "createdBy", "createdDate"]
    },
    "EmployeeSalaryStructure": {
      "title": "EmployeeSalaryStructure",
      "description": "Employee basic salary, allowances, and recurring deductions setup.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "employeeId": { "type": "string", "maxLength": 128 },
        "basicSalary": { "type": "number" },
        "positionAllowance": { "type": "number" },
        "transportAllowance": { "type": "number" },
        "housingAllowance": { "type": "number" },
        "responsibilityAllowance": { "type": "number" },
        "telephoneAllowance": { "type": "number" },
        "overtimeAmount": { "type": "number" },
        "otherEarnings": { "type": "number" },
        "isPensionEligible": { "type": "boolean" },
        "effectiveDate": { "type": "string", "maxLength": 16 },
        "updatedBy": { "type": "string", "maxLength": 256 },
        "updatedDate": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "employeeId", "basicSalary", "positionAllowance", "transportAllowance", "housingAllowance", "isPensionEligible", "effectiveDate", "updatedBy", "updatedDate"]
    },
    "PayrollRecord": {
      "title": "PayrollRecord",
      "description": "Calculated or imported monthly salary record per employee.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "payrollPeriodId": { "type": "string", "maxLength": 128 },
        "payrollPeriodName": { "type": "string", "maxLength": 128 },
        "employeeId": { "type": "string", "maxLength": 128 },
        "employeeName": { "type": "string", "maxLength": 256 },
        "departmentId": { "type": "string", "maxLength": 128 },
        "basicSalary": { "type": "number" },
        "grossSalary": { "type": "number" },
        "incomeTax": { "type": "number" },
        "employeePension": { "type": "number" },
        "totalDeductions": { "type": "number" },
        "netSalary": { "type": "number" },
        "employerPension": { "type": "number" },
        "status": { "type": "string", "enum": ["Open", "Calculated", "Submitted", "Approved", "Closed", "Locked"] },
        "calculatedDate": { "type": "string", "maxLength": 64 },
        "calculatedBy": { "type": "string", "maxLength": 256 }
      },
      "required": ["id", "payrollPeriodId", "payrollPeriodName", "employeeId", "employeeName", "departmentId", "basicSalary", "grossSalary", "incomeTax", "employeePension", "totalDeductions", "netSalary", "employerPension", "status", "calculatedDate", "calculatedBy"]
    },
    "Payslip": {
      "title": "Payslip",
      "description": "Individual monthly payslip document.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "payslipRefNo": { "type": "string", "maxLength": 128 },
        "payrollPeriodId": { "type": "string", "maxLength": 128 },
        "employeeId": { "type": "string", "maxLength": 128 },
        "employeeName": { "type": "string", "maxLength": 256 },
        "grossSalary": { "type": "number" },
        "totalDeductions": { "type": "number" },
        "netSalary": { "type": "number" },
        "employerPension": { "type": "number" },
        "generatedDate": { "type": "string", "maxLength": 64 },
        "generatedBy": { "type": "string", "maxLength": 256 }
      },
      "required": ["id", "payslipRefNo", "payrollPeriodId", "employeeId", "employeeName", "grossSalary", "totalDeductions", "netSalary", "employerPension", "generatedDate", "generatedBy"]
    },
    "PayslipDistributionLog": {
      "title": "PayslipDistributionLog",
      "description": "Email sending log for payslip distribution.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "employeeId": { "type": "string", "maxLength": 128 },
        "recipientEmail": { "type": "string", "maxLength": 256 },
        "payrollPeriodId": { "type": "string", "maxLength": 128 },
        "sendingDate": { "type": "string", "maxLength": 64 },
        "deliveryStatus": { "type": "string", "enum": ["Sent", "Failed", "Pending"] },
        "sentBy": { "type": "string", "maxLength": 256 }
      },
      "required": ["id", "employeeId", "recipientEmail", "payrollPeriodId", "sendingDate", "deliveryStatus", "sentBy"]
    },
    "PayrollApproval": {
      "title": "PayrollApproval",
      "description": "Monthly payroll approval submission and verification record.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "payrollPeriodId": { "type": "string", "maxLength": 128 },
        "periodName": { "type": "string", "maxLength": 128 },
        "submittedBy": { "type": "string", "maxLength": 256 },
        "submittedDate": { "type": "string", "maxLength": 64 },
        "totalEmployees": { "type": "number" },
        "totalGross": { "type": "number" },
        "totalNet": { "type": "number" },
        "status": { "type": "string", "enum": ["Draft", "Calculated", "Submitted", "Approved", "Rejected", "Reopened"] }
      },
      "required": ["id", "payrollPeriodId", "periodName", "submittedBy", "submittedDate", "totalEmployees", "totalGross", "totalNet", "status"]
    },
    "PayrollImportLog": {
      "title": "PayrollImportLog",
      "description": "Audit record of CSV import runs.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "filename": { "type": "string", "maxLength": 256 },
        "importMode": { "type": "string", "enum": ["Salary Structure", "Monthly Payroll"] },
        "payrollPeriod": { "type": "string", "maxLength": 128 },
        "totalRows": { "type": "number" },
        "successfulRows": { "type": "number" },
        "failedRows": { "type": "number" },
        "timestamp": { "type": "string", "maxLength": 64 },
        "importedBy": { "type": "string", "maxLength": 256 }
      },
      "required": ["id", "filename", "importMode", "payrollPeriod", "totalRows", "successfulRows", "failedRows", "timestamp", "importedBy"]
    },
    "PayrollSettings": {
      "title": "PayrollSettings",
      "description": "General payroll configurations.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "companyName": { "type": "string", "maxLength": 256 },
        "currency": { "type": "string", "maxLength": 32 },
        "autoEmailPayslipsOnApproval": { "type": "boolean" },
        "updatedBy": { "type": "string", "maxLength": 256 },
        "updatedDate": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "companyName", "currency", "autoEmailPayslipsOnApproval", "updatedBy", "updatedDate"]
    }
  },
  "firestore": {
    "users": {
      "schema": "User",
      "description": "Gated system operators"
    },
    "departments": {
      "schema": "Department",
      "description": "Organizational departments"
    },
    "employees": {
      "schema": "Employee",
      "description": "Employee database profiles"
    },
    "attendance": {
      "schema": "AttendanceRecord",
      "description": "Daily attendance checkpoints"
    },
    "leaves": {
      "schema": "LeaveRecord",
      "description": "Leave bookings"
    },
    "holidays": {
      "schema": "PublicHoliday",
      "description": "Public holidays calendar"
    },
    "config": {
      "schema": "CompanyConfig",
      "description": "Central company settings document"
    },
    "logs": {
      "schema": "ActivityLog",
      "description": "Immutable auditing logs"
    },
    "family_members": {
      "schema": "FamilyMember",
      "description": "Employee registered family dependents"
    },
    "medical_expenses": {
      "schema": "MedicalExpense",
      "description": "Medical expense claims registry"
    },
    "salary_components": {
      "schema": "SalaryComponent",
      "description": "Earnings and deductions salary components"
    },
    "tax_configurations": {
      "schema": "TaxConfiguration",
      "description": "Progressive tax brackets and pension rates"
    },
    "payroll_periods": {
      "schema": "PayrollPeriod",
      "description": "Monthly payroll processing periods"
    },
    "employee_salary_structures": {
      "schema": "EmployeeSalaryStructure",
      "description": "Employee base salary and allowances setup"
    },
    "payroll_records": {
      "schema": "PayrollRecord",
      "description": "Monthly payroll ledger calculations"
    },
    "payslips": {
      "schema": "Payslip",
      "description": "Employee monthly payslips"
    },
    "payslip_distribution_logs": {
      "schema": "PayslipDistributionLog",
      "description": "Email delivery logs for payslips"
    },
    "payroll_approvals": {
      "schema": "PayrollApproval",
      "description": "Payroll verification and approval workflow tracking"
    },
    "payroll_import_logs": {
      "schema": "PayrollImportLog",
      "description": "CSV import audit log records"
    },
    "payroll_settings": {
      "schema": "PayrollSettings",
      "description": "General payroll module settings"
    },
    "email_logs": {
      "schema": "EmailActivityLog",
      "description": "Central system email delivery and blocked status audit logs"
    }
  }
}
